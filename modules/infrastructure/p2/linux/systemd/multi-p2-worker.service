[Unit]
Description=Multi P2 worker foundation (isolated launch adapter unavailable)
After=local-fs.target
AssertPathIsDirectory=/var/lib/multi-p2/worker-rootfs
AssertPathExists=/var/lib/multi-p2/worker-rootfs/opt/multi-p2/worker_entry.py

[Service]
Type=exec
User=multi-p2-worker
Group=multi-p2-workers
RootDirectory=/var/lib/multi-p2/worker-rootfs
WorkingDirectory=/job
ExecStart=/usr/bin/python3 -I -S -B /opt/multi-p2/worker_entry.py --run
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
PrivateMounts=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=~@mount @reboot @swap @raw-io @debug
SystemCallArchitectures=native
MemoryMax=512M
TasksMax=64
CPUQuota=100%
RuntimeMaxSec=30s
LimitNOFILE=64
LimitFSIZE=8M
LimitCORE=0
KillMode=control-group
TimeoutStopSec=5s
Restart=no
StandardOutput=null
StandardError=null
# No host binds, management sockets, publisher credentials or login services.
# No PID namespace claim: this release never executes candidate code.
# A worker UID cannot be reassigned to a different enrollment in this release.
