[Unit]
Description=Multi P2 root-managed publisher RPC endpoint

[Socket]
ListenStream=/run/multi-p2-rpc/publish.sock
SocketUser=multi-p2-publish
SocketGroup=multi-p2-control
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Accept=no
Service=multi-p2-publisher.service
# No network listener or caller-selected executable.

[Install]
WantedBy=sockets.target
