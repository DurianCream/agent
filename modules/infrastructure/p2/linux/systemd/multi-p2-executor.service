[Unit]
Description=Multi P2 trusted root verification/execution supervisor
After=local-fs.target
AssertPathExists=/etc/multi-p2/rpc.json

[Service]
Type=exec
ExitType=main
# System-service default root is required. On systemd 255, explicit User=root
# with syscall filtering drops CAP_SETUID before our trusted privilege drop.
# worker_entry and the executor independently require euid 0; no ambient caps.
Group=root
ExecStart=/opt/multi-p2-python/bin/python3 -I -S -B /opt/multi-p2/worker_entry.py --rpc
WorkingDirectory=/
UMask=0077
Delegate=cpu memory pids
DelegateSubgroup=supervisor
PrivateMounts=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/multi-p2/executor /var/lib/multi-p2/verification /sys/fs/cgroup/system.slice/multi-p2-executor.service
NoNewPrivileges=yes
KeyringMode=private
SystemCallFilter=~@keyring @debug
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1536M
TasksMax=128
CPUQuota=200%
LimitCORE=0
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=5s
RuntimeMaxSec=360s
Restart=no
# No Install section, socket or polkit grant. Operator/manual invocation only.
# The root observer is trusted; only its child drops to the dedicated worker.
