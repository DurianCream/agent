[Unit]
Description=Multi P2 root-managed verifier RPC endpoint

[Socket]
ListenStream=/run/multi-p2-rpc/verify.sock
SocketUser=root
SocketGroup=multi-p2-control
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Accept=no
Service=multi-p2-executor.service
[Install]
WantedBy=sockets.target
# Enable only after the operational namespace prerequisites are approved.
