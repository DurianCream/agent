    "module": {
      "id": "orchestrator",
      "version": "0.2.0"
    },
    "objective": "Linux SoftEther 서버와 Windows 클라이언트에서 기존 RADIUS 인증을 유지하는 프로토콜 선택 및 NAT 단말 감사로그 설계를 공식 근거로 정리",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "주요 VPN 프로토콜의 실제 지원 범위와 RADIUS 제약을 공식 근거로 비교하고 하나를 권고한다",
        "required": true
      },
      {
        "id": "criterion-2",
        "description": "사용자·접속 IP·단말·VPN 서버·시작과 종료 시각의 수집 필드와 NAT 및 단말 신뢰 한계를 구분한다",
        "required": true
      },
      {
        "id": "criterion-3",
        "description": "감사로그 설정 방향·업그레이드 절차·검증 시나리오와 미확인을 제시한다",
        "required": true
      },
      {
        "id": "criterion-4",
        "description": "별도 evaluator가 근거와 핵심 결론을 검증한다",
        "required": true
      }
    ]
