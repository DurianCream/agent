{
  "schema_version": "0.1.0",
  "enabled": true,
  "repository_id": "multi",
  "selector": {
    "project": "multi",
    "service": "agent-framework",
    "environment": "development"
  },
  "required_suites": [
    {
      "id": "p1-regression",
      "argv": [
        "@project-python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "runtime/tests",
        "-p",
        "test_control_gate*.py",
        "-v"
      ]
    }
  ],
  "timeout_seconds": 600,
  "policy": {
    "submission": "allow",
    "publication": "allow"
  },
  "author": {
    "subject": "orchestrator",
    "session": "root"
  }
}
