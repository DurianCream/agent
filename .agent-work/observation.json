{
  "schema_version": "0.1.0",
  "enabled": true,
  "repository_id": "multi",
  "selector": {
    "project": "multi",
    "service": "agent-framework",
    "environment": "development"
  },
  "interpreter": {
    "windows": ".venv-controls/Scripts/python.exe",
    "posix": ".venv-controls/bin/python"
  },
  "timeout_seconds": 30,
  "max_age_seconds": 300,
  "policy_path": "shared/policies/execution-controls.observe.json",
  "target": {
    "data_classification": "internal",
    "risk_level": "low",
    "reversible": true
  }
}
