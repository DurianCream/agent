{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registry 1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "minItems": 1
    }
  }
}
