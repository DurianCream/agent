{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi:control-observation:0.1.0",
  "title": "Non-executable policy observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "mode",
    "decision",
    "risk",
    "reason_codes",
    "observed_at",
    "request_digest",
    "policy_digest",
    "context_digest",
    "executable",
    "authority_verified",
    "content_checks",
    "signature_verification"
  ],
  "properties": {
    "record_type": {
      "const": "policy_observation"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "mode": {
      "const": "observe"
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        "require_review"
      ]
    },
    "risk": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "enum": [
          "within_declared_bounds",
          "high_risk_review",
          "invalid_request",
          "unsupported_record_type",
          "invalid_context",
          "invalid_policy",
          "scope_mismatch",
          "identity_mismatch",
          "target_mismatch",
          "policy_mismatch",
          "request_expired",
          "request_not_yet_valid",
          "request_lifetime_exceeded",
          "adapter_not_enabled",
          "environment_not_enabled",
          "budget_exceeded",
          "authorization_missing",
          "authorization_mismatch",
          "authorization_expired",
          "path_not_authorized",
          "artifact_not_authorized",
          "publication_mismatch",
          "operation_not_authorized",
          "critical_risk",
          "sensitive_data",
          "data_classification_mismatch",
          "internal_error"
        ]
      },
      "maxItems": 10,
      "uniqueItems": true,
      "minItems": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "request_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      ]
    },
    "policy_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      ]
    },
    "context_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      ]
    },
    "executable": {
      "const": false
    },
    "authority_verified": {
      "const": false
    },
    "content_checks": {
      "const": "not_performed"
    },
    "signature_verification": {
      "const": "not_performed"
    }
  }
}
