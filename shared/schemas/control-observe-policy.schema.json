{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi:control-observe-inputs:0.1.0",
  "title": "P0 declared observation inputs 0.1.0",
  "description": "Policy and context are declared simulation data, not authenticated authorization.",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\u0000]+$"
    },
    "adapter": {
      "enum": [
        "workspace.inspect",
        "workspace.apply_patch",
        "repo.publish",
        "infrastructure.change",
        "external.export"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_attempts",
        "max_bytes",
        "max_cost_microunits",
        "max_actions"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "max_cost_microunits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "service",
        "environment",
        "issue"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/identifier"
        },
        "service": {
          "$ref": "#/$defs/identifier"
        },
        "environment": {
          "$ref": "#/$defs/identifier"
        },
        "issue": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "host_id",
        "session_id",
        "role"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/identifier"
        },
        "host_id": {
          "$ref": "#/$defs/identifier"
        },
        "session_id": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote",
        "remote_url",
        "branch",
        "commit",
        "owned_manifest_digest"
      ],
      "properties": {
        "remote": {
          "const": "origin"
        },
        "remote_url": {
          "type": "string",
          "maxLength": 1024,
          "format": "uri",
          "pattern": "^https://[^/?#@]+/[^?#@]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "owned_manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository_id",
        "task_id",
        "scope",
        "subject_id",
        "target_id",
        "adapters",
        "paths",
        "artifact_digests",
        "publication",
        "expires_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "task",
            "standing"
          ]
        },
        "repository_id": {
          "$ref": "#/$defs/identifier"
        },
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "subject_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_id": {
          "$ref": "#/$defs/identifier"
        },
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adapter"
          },
          "maxItems": 5,
          "uniqueItems": true,
          "minItems": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "publication": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/publication"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "environment",
        "data_classification",
        "risk_level",
        "reversible",
        "allowed_operations",
        "resource_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "environment": {
          "enum": [
            "development",
            "staging",
            "production"
          ]
        },
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "secret"
          ]
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "enum": [
              "config.change",
              "config.rollback"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 256,
          "uniqueItems": true
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "schema_version",
        "id",
        "version",
        "mode",
        "allowed_environments",
        "enabled_adapters",
        "max_request_lifetime_seconds",
        "budget_limits"
      ],
      "properties": {
        "document_type": {
          "const": "observe_policy"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "id": {
          "const": "development-observe"
        },
        "version": {
          "const": "0.1.0"
        },
        "mode": {
          "const": "observe"
        },
        "allowed_environments": {
          "type": "array",
          "items": {
            "enum": [
              "development",
              "staging",
              "production"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true,
          "minItems": 1
        },
        "enabled_adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adapter"
          },
          "maxItems": 5,
          "uniqueItems": true,
          "minItems": 1
        },
        "max_request_lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "budget_limits": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "schema_version",
        "repository_id",
        "task_id",
        "scope",
        "requester",
        "target",
        "authorization"
      ],
      "properties": {
        "document_type": {
          "const": "observe_context"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "repository_id": {
          "$ref": "#/$defs/identifier"
        },
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "requester": {
          "$ref": "#/$defs/identity"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "authorization": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/authorization"
            }
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/context"
    }
  ]
}
