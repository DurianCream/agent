{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy 1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "result_contract",
    "allowed_artifact_roots",
    "default_language",
    "enforcement",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "result_contract": {
      "type": "object",
      "required": [
        "version",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowed_artifact_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "default_language": {
      "const": "ko"
    },
    "enforcement": {
      "const": "host"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
