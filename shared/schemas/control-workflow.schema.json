{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi:control-workflow:0.1.0",
  "title": "P0 workflow records, not execution authorization",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "record_id": {
      "type": "string",
      "pattern": "^obs-[a-f0-9]{32}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "service",
        "environment",
        "issue"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/id"
        },
        "service": {
          "$ref": "#/$defs/id"
        },
        "environment": {
          "$ref": "#/$defs/id"
        },
        "issue": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "host_id",
        "session_id",
        "role"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/id"
        },
        "host_id": {
          "$ref": "#/$defs/id"
        },
        "session_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "phase": {
      "enum": [
        "workspace",
        "publication"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_classification",
        "risk_level",
        "reversible"
      ],
      "properties": {
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "secret"
          ]
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reversible": {
          "type": "boolean"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enabled",
        "repository_id",
        "selector",
        "interpreter",
        "timeout_seconds",
        "max_age_seconds",
        "policy_path",
        "target"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "enabled": {
          "type": "boolean"
        },
        "repository_id": {
          "$ref": "#/$defs/id"
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "service",
            "environment"
          ],
          "properties": {
            "project": {
              "$ref": "#/$defs/id"
            },
            "service": {
              "$ref": "#/$defs/id"
            },
            "environment": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "interpreter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windows",
            "posix"
          ],
          "properties": {
            "windows": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "posix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "policy_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "assessment_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "record_id",
        "snapshot_digest",
        "policy_digest",
        "scope",
        "role",
        "reviewer",
        "assessment",
        "reason_codes",
        "governance_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "record_id": {
          "$ref": "#/$defs/record_id"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "role": {
          "enum": [
            "governance",
            "evaluator"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/identity"
        },
        "assessment": {
          "enum": [
            "proceed",
            "revise",
            "escalate",
            "accepted",
            "rework",
            "inconclusive"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "enum": [
              "bounds_confirmed",
              "criteria_met",
              "missing_evidence",
              "risk_unresolved",
              "rework_needed",
              "authorization_uncertain",
              "independence_unverified",
              "governance_not_required"
            ]
          },
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true
        },
        "governance_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "governance"
              }
            }
          },
          "then": {
            "properties": {
              "assessment": {
                "enum": [
                  "proceed",
                  "revise",
                  "escalate"
                ]
              },
              "governance_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "evaluator"
              }
            }
          },
          "then": {
            "properties": {
              "assessment": {
                "enum": [
                  "accepted",
                  "rework",
                  "inconclusive"
                ]
              },
              "governance_digest": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/digest"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "assessment_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "assessment_id",
        "created_at",
        "input",
        "digest",
        "identity_authenticated",
        "executable",
        "authority_verified"
      ],
      "properties": {
        "record_type": {
          "const": "workflow_assessment"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "assessment_id": {
          "type": "string",
          "pattern": "^asm-[a-f0-9]{32}$"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "input": {
          "$ref": "#/$defs/assessment_input"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "identity_authenticated": {
          "const": false
        },
        "executable": {
          "const": false
        },
        "authority_verified": {
          "const": false
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "record_id",
        "task_id",
        "phase",
        "created_at",
        "expires_at",
        "snapshot",
        "snapshot_digest",
        "request",
        "context",
        "result",
        "provenance",
        "digest",
        "executable",
        "authority_verified",
        "policy"
      ],
      "properties": {
        "record_type": {
          "const": "workflow_observation"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "record_id": {
          "$ref": "#/$defs/record_id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        },
        "snapshot": {
          "type": "object",
          "required": [
            "content_basis",
            "owned_files"
          ],
          "oneOf": [
            {
              "properties": {
                "content_basis": {
                  "const": "working-tree-bytes"
                },
                "owned_files": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "$ref": "#/$defs/workspace_entry"
                  }
                }
              }
            },
            {
              "properties": {
                "content_basis": {
                  "const": "git-object-metadata"
                },
                "owned_files": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "$ref": "#/$defs/committed_entry"
                  }
                }
              }
            }
          ]
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "request": {
          "type": "object"
        },
        "context": {
          "type": "object"
        },
        "result": {
          "type": "object"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invocation",
            "meaning",
            "authorization_source",
            "identity_authenticated",
            "input_contents_stored"
          ],
          "properties": {
            "invocation": {
              "const": "control_policy.evaluate_action"
            },
            "meaning": {
              "enum": [
                "owned-workset-inspection",
                "actual-commit-publication-observation"
              ]
            },
            "authorization_source": {
              "enum": [
                "declared-task-binding-and-owned-paths",
                "declared-repository-automation-setting",
                "missing"
              ]
            },
            "identity_authenticated": {
              "const": false
            },
            "input_contents_stored": {
              "const": false
            }
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "executable": {
          "const": false
        },
        "authority_verified": {
          "const": false
        },
        "policy": {
          "type": "object"
        },
        "supersession": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "explicit_refresh",
            "previous_record_id",
            "previous_file_digest",
            "previous_validation"
          ],
          "properties": {
            "explicit_refresh": {
              "const": true
            },
            "previous_record_id": {
              "oneOf": [
                {
                  "$ref": "#/$defs/record_id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "previous_file_digest": {
              "oneOf": [
                {
                  "$ref": "#/$defs/digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "previous_validation": {
              "enum": [
                "valid",
                "stale",
                "error",
                "invalid",
                "missing",
                "oversized"
              ]
            }
          }
        }
      }
    },
    "error_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "record_id",
        "task_id",
        "phase",
        "created_at",
        "status",
        "reason_code",
        "digest",
        "executable",
        "authority_verified"
      ],
      "properties": {
        "record_type": {
          "const": "workflow_error"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "record_id": {
          "$ref": "#/$defs/record_id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "enum": [
            "error",
            "not_ready"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "executable": {
          "const": false
        },
        "authority_verified": {
          "const": false
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "latest",
        "assessments"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "latest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspace": {
              "$ref": "#/$defs/record_id"
            },
            "publication": {
              "$ref": "#/$defs/record_id"
            }
          }
        },
        "assessments": {
          "type": "object",
          "patternProperties": {
            "^obs-[a-f0-9]{32}$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "governance": {
                  "type": "string",
                  "pattern": "^asm-[a-f0-9]{32}$"
                },
                "evaluator": {
                  "type": "string",
                  "pattern": "^asm-[a-f0-9]{32}$"
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "workspace_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "state",
        "digest",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "state": {
          "enum": [
            "file",
            "missing"
          ]
        },
        "digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      }
    },
    "committed_entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "state",
            "git_mode",
            "git_type",
            "git_object_id",
            "git_size"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "state": {
              "const": "committed_blob"
            },
            "git_mode": {
              "enum": [
                "100644",
                "100755",
                "120000"
              ]
            },
            "git_type": {
              "const": "blob"
            },
            "git_object_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "git_size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 67108864
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "state",
            "git_mode",
            "git_type",
            "git_object_id",
            "git_size"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "state": {
              "const": "deleted"
            },
            "git_mode": {
              "type": "null"
            },
            "git_type": {
              "type": "null"
            },
            "git_object_id": {
              "type": "null"
            },
            "git_size": {
              "type": "null"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/profile"
    },
    {
      "$ref": "#/$defs/assessment_input"
    },
    {
      "$ref": "#/$defs/assessment_record"
    },
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/error_record"
    },
    {
      "$ref": "#/$defs/index"
    }
  ]
}
