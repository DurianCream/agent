{
  "document_type": "observe_policy",
  "schema_version": "0.1.0",
  "id": "development-observe",
  "version": "0.1.0",
  "mode": "observe",
  "allowed_environments": [
    "development"
  ],
  "enabled_adapters": [
    "workspace.inspect",
    "workspace.apply_patch",
    "repo.publish"
  ],
  "max_request_lifetime_seconds": 300,
  "budget_limits": {
    "timeout_seconds": 60,
    "max_attempts": 1,
    "max_bytes": 1048576,
    "max_cost_microunits": 0,
    "max_actions": 1
  }
}
