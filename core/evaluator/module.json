{
  "schema_version": "1.0.0",
  "id": "evaluator",
  "name": "Evaluator",
  "version": "0.1.3",
  "kind": "system",
  "lifecycle": "experimental",
  "description": "Verify acceptance criteria, regressions, and failure cases.",
  "instructions": "core/evaluator/instructions.md",
  "capabilities": [
    "evaluate-result",
    "evaluate-module",
    "regression-review"
  ],
  "triggers": [
    "Requests to verify artifacts, completion criteria, or regressions"
  ],
  "input_fields": [
    "objective",
    "acceptance_criteria",
    "project_context",
    "authorized_scope"
  ],
  "tools": [
    "filesystem",
    "shell"
  ],
  "scope": {
    "read": [
      "core/",
      "modules/",
      "shared/",
      "runtime/",
      "evals/",
      "runs/",
      "outputs/"
    ],
    "write": [
      "evals/",
      "runs/",
      "outputs/"
    ]
  },
  "dependencies": [],
  "skills": [
    {
      "id": "submit-result",
      "version": "1.2.0",
      "path": "shared/skills/submit-result/SKILL.md"
    },
    {
      "id": "maintain-module",
      "version": "1.0.1",
      "path": "shared/skills/maintain-module/SKILL.md"
    }
  ],
  "policies": [
    {
      "id": "common",
      "version": "1.2.0",
      "path": "shared/policies/common.json"
    }
  ],
  "result_contract": {
    "version": "1.0.0",
    "path": "shared/schemas/result.schema.json"
  }
}
