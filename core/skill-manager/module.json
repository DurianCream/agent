{
  "schema_version": "1.0.0",
  "id": "skill-manager",
  "name": "Skill and Module Manager",
  "version": "0.1.4",
  "kind": "system",
  "lifecycle": "experimental",
  "description": "Maintain skills, module registration, dependencies, and versions.",
  "instructions": "core/skill-manager/instructions.md",
  "capabilities": [
    "maintain-skill",
    "register-module",
    "manage-versions"
  ],
  "triggers": [
    "Requests to add or revise a skill or specialist agent",
    "Requests to turn repeated procedures into reusable modules"
  ],
  "input_fields": [
    "objective",
    "acceptance_criteria",
    "project_context",
    "authorized_scope"
  ],
  "tools": [
    "filesystem",
    "shell"
  ],
  "scope": {
    "read": [
      "core/",
      "modules/",
      "shared/",
      "runtime/",
      "evals/",
      "runs/",
      "outputs/"
    ],
    "write": [
      "core/",
      "modules/",
      "shared/skills/",
      "registry.json",
      "runs/",
      "outputs/"
    ]
  },
  "dependencies": [],
  "skills": [
    {
      "id": "submit-result",
      "version": "1.3.0",
      "path": "shared/skills/submit-result/SKILL.md"
    },
    {
      "id": "maintain-module",
      "version": "1.0.1",
      "path": "shared/skills/maintain-module/SKILL.md"
    }
  ],
  "policies": [
    {
      "id": "common",
      "version": "1.2.0",
      "path": "shared/policies/common.json"
    }
  ],
  "result_contract": {
    "version": "1.0.0",
    "path": "shared/schemas/result.schema.json"
  }
}
