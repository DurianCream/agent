{
  "schema_version": "1.0.0",
  "id": "orchestrator",
  "name": "Orchestrator",
  "version": "0.2.3",
  "kind": "system",
  "lifecycle": "experimental",
  "description": "Interpret requests, select modules, coordinate dependencies, and integrate results.",
  "instructions": "core/orchestrator/instructions.md",
  "capabilities": [
    "route-task",
    "coordinate",
    "integrate-results"
  ],
  "triggers": [
    "Default delegation for technical questions, design, research, analysis, implementation, changes, and reviews",
    "Requests requiring assignments, independent evaluation, and result integration"
  ],
  "input_fields": [
    "objective",
    "acceptance_criteria",
    "project_context",
    "authorized_scope"
  ],
  "tools": [
    "filesystem",
    "shell"
  ],
  "scope": {
    "read": [
      "core/",
      "modules/",
      "shared/",
      "runtime/",
      "evals/",
      "runs/",
      "outputs/"
    ],
    "write": [
      "runs/",
      "outputs/"
    ]
  },
  "dependencies": [],
  "skills": [
    {
      "id": "submit-result",
      "version": "1.2.0",
      "path": "shared/skills/submit-result/SKILL.md"
    }
  ],
  "policies": [
    {
      "id": "common",
      "version": "1.2.0",
      "path": "shared/policies/common.json"
    }
  ],
  "result_contract": {
    "version": "1.0.0",
    "path": "shared/schemas/result.schema.json"
  }
}
