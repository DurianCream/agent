{
  "schema_version": "1.0.0",
  "id": "policy-manager",
  "name": "Policy Manager",
  "version": "0.2.0",
  "kind": "system",
  "lifecycle": "experimental",
  "description": "Assess contextual governance requirements and policy conflicts, and propose testable controls without granting execution authority.",
  "instructions": "core/policy-manager/instructions.md",
  "capabilities": [
    "maintain-policy",
    "review-conflicts",
    "assess-governance-context",
    "specify-testable-controls"
  ],
  "triggers": [
    "Requests to design or change policies, permission scope, or submission rules",
    "Material changes to data use, authority, risk or deployment scope that require governance interpretation",
    "Unresolved policy applicability, conflicting requirements or an explicit governance review request"
  ],
  "input_fields": [
    "objective",
    "acceptance_criteria",
    "project_context",
    "authorized_scope"
  ],
  "tools": [
    "filesystem",
    "shell"
  ],
  "scope": {
    "read": [
      "core/",
      "modules/",
      "shared/",
      "runtime/",
      "evals/",
      "runs/",
      "outputs/"
    ],
    "write": [
      "shared/policies/",
      "runs/",
      "outputs/"
    ]
  },
  "dependencies": [],
  "skills": [
    {
      "id": "submit-result",
      "version": "1.2.0",
      "path": "shared/skills/submit-result/SKILL.md"
    },
    {
      "id": "maintain-module",
      "version": "1.0.1",
      "path": "shared/skills/maintain-module/SKILL.md"
    }
  ],
  "policies": [
    {
      "id": "common",
      "version": "1.2.0",
      "path": "shared/policies/common.json"
    }
  ],
  "result_contract": {
    "version": "1.0.0",
    "path": "shared/schemas/result.schema.json"
  }
}
