__pycache__/
*.py[cod]
.venv/
.venv-controls/
work/
runs/*
!runs/.gitkeep

# Machine-local bindings and generated executable paths
runtime/repos.local.json
.codex/hooks.json
.agent-work/*.lock

# User reports are published through .agent-work; retain local historical outputs
outputs/

# Real infrastructure mappings stay local. Only schema and pseudonymous fixture are tracked.
/modules/infrastructure/inventory*
!/modules/infrastructure/inventory.schema.json
!/modules/infrastructure/inventory.example.json

# Generated local task views
.agent-work/index.json
.agent-work/INDEX.md
